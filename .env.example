# Local development defaults. In production put the app behind HTTPS and set this to 1.
CHAKRA_COOKIE_SECURE=0
CHAKRA_SESSION_TTL=28800
CHAKRA_SESSION_IDLE=3600
CHAKRA_MAX_BODY_BYTES=1048576
CHAKRA_ALLOWED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001
CHAKRA_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional custom locations:
# CHAKRA_DB_PATH=C:\secure\chakra_security.db
# CHAKRA_SIGNING_KEY_PATH=C:\secure\passport_ed25519.pem

# Configurable request throttling / authentication backoff
CHAKRA_LOGIN_IP_LIMIT=10
CHAKRA_LOGIN_IP_WINDOW=300
CHAKRA_PUBLIC_API_LIMIT=60
CHAKRA_PUBLIC_API_WINDOW=60
CHAKRA_AUTH_API_LIMIT=180
CHAKRA_AUTH_API_WINDOW=60
CHAKRA_WEB_RATE_LIMIT=240
CHAKRA_WEB_RATE_WINDOW=60
CHAKRA_AUTH_BACKOFF_BASE=2
CHAKRA_AUTH_BACKOFF_MAX=900
